{
  "name": "@rijverse/ctx",
  "version": "1.0.0",
  "description": "One source of truth for every Claude Code account on a machine: shared context, separate logins.",
  "type": "module",
  "bin": {
    "ctx": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "start": "node dist/cli.js",
    "pretest": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "claude",
    "cli",
    "accounts",
    "profiles",
    "context",
    "symlink"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
